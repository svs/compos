{
  "manifest_version": 3,
  "name": "compos",
  "version": "0.7.0",
  "description": "compos's keys and commands in every tab, and a wire so the editor can drive any of them.",
  "icons": {
    "16": "icons/compos-16.png",
    "32": "icons/compos-32.png",
    "48": "icons/compos-48.png",
    "128": "icons/compos-128.png"
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "debugger",
    "alarms",
    "system.display",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "sw.js",
    "scripts": [
      "sw.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "compos@svs.io",
      "strict_min_version": "128.0"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "sidebar_action": {
    "default_title": "compos",
    "default_panel": "sidepanel.html",
    "default_icon": "icons/compos-32.png",
    "open_at_install": false
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "compos \u2014 chat about this tab",
    "default_icon": {
      "16": "icons/compos-16.png",
      "32": "icons/compos-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "overlay.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "omnibox": {
    "keyword": "compos"
  },
  "commands": {
    "focus-compos": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Jump to compos in this window"
    }
  }
}
